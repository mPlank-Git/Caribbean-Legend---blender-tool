<Window x:Class="BuryaPresetEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Burya Preset Editor"
        Height="720"
        Width="1400"
        MinHeight="650"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Language="en-US"
        FontFamily="Georgia"
        FontWeight="SemiBold"
        Background="#080603">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4A3218"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F0D789"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2C1C0E"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080603"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#17100A"/>
        <SolidColorBrush x:Key="PanelDarkAltBrush" Color="#21160C"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#7A5523"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#D8B45C"/>
        <SolidColorBrush x:Key="GoldBrightBrush" Color="#F0D789"/>
        <SolidColorBrush x:Key="PaperTextBrush" Color="#18100A"/>
        <SolidColorBrush x:Key="PaperLineBrush" Color="#7C5B2E"/>
        <LinearGradientBrush x:Key="PaperBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D7BE82" Offset="0"/>
            <GradientStop Color="#E7D099" Offset="0.34"/>
            <GradientStop Color="#C9A866" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DarkPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#100A05" Offset="0"/>
            <GradientStop Color="#24170C" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#24170C"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                <Setter Property="Foreground" Value="#FFE9A8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A2714"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFE9A8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#77684B"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#120C07"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#120C07"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#120C07"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Foreground" Value="#FFE9A8"/>
                    <Setter Property="Background" Value="#3A2714"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFE9A8"/>
                    <Setter Property="Background" Value="#4A3218"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}"/>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#120C07"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#120C07"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#120C07"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFE9A8"/>
                    <Setter Property="Background" Value="#3A2714"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFE9A8"/>
                    <Setter Property="Background" Value="#2C1C0E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#120C07"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1"
                                    Margin="0,-8,0,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ContentPresenter Margin="8,14,8,8"/>
                            </Border>

                            <Border Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0"
                                    Padding="5,0"
                                    Background="{StaticResource PanelDarkBrush}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#100A05"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#100A05"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PaperTextBrush}"/>
            <Setter Property="RowBackground" Value="#E1C98F"/>
            <Setter Property="AlternatingRowBackground" Value="#D2B77A"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PaperLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PaperLineBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource PaperLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3A2714"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource PaperLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource PaperTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource PaperLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5A3A1A"/>
                    <Setter Property="Foreground" Value="#FFE9A8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource PaperTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource AppBackgroundBrush}">

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Выбрать resource папку" Click="SelectResourceFolder_Click"/>
                <Separator/>
                <MenuItem Header="Открыть JSON вручную" Click="OpenJson_Click"/>
                <MenuItem Header="Сохранить" Click="SaveJson_Click"/>
                <MenuItem Header="Сохранить как" Click="SaveJsonAs_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Правка">
                <MenuItem Header="Копировать весь индекс" Click="CopyHour_Click"/>
                <MenuItem Header="Размножить весь индекс на все" Click="PasteHourToAll_Click"/>
            </MenuItem>

            <MenuItem Header="Инструменты">
                <MenuItem Header="Проверить пресет" Click="ValidatePreset_Click"/>
                <MenuItem Header="Нормализовать строки" Click="NormalizeHours_Click"/>
            </MenuItem>
        </Menu>

        <Grid x:Name="MainLayoutGrid" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="400" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftPanelBorder" Grid.Column="0"
                    Background="{StaticResource DarkPanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0"
                    TextElement.Foreground="{StaticResource GoldBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Пресеты"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,8"/>

                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="Выбрать resource папку"
                                Height="30"
                                Margin="0,0,0,6"
                                Click="SelectResourceFolder_Click"/>

                        <TextBlock Text="Resource:"
                                   FontWeight="Bold"
                                   Margin="0,4,0,2"/>

                        <TextBlock Text="{Binding ResourceFolderText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Режим:"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <ComboBox ItemsSource="{Binding EditorModes}"
                                  SelectedItem="{Binding SelectedEditorMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Height="28"
                                  Margin="0,0,0,8"
                                  SelectionChanged="EditorMode_SelectionChanged"/>

                        <Button Content="Открыть JSON вручную"
                                Height="30"
                                Margin="0,0,0,6"
                                Click="OpenJson_Click"/>

                        <Button Content="Сохранить"
                                Height="30"
                                Margin="0,0,0,6"
                                Click="SaveJson_Click"/>

                        <Button Content="Сохранить как"
                                Height="30"
                                Margin="0,0,0,10"
                                Click="SaveJsonAs_Click"/>

                        <GroupBox Header="Мониторинг файла" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <CheckBox Content="Автообновление текущего JSON"
                                          IsChecked="{Binding IsFileMonitoringEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"/>

                                <TextBlock Text="Режим конфликта:" Margin="0,0,0,4"/>

                                <ComboBox ItemsSource="{Binding AutoReloadModes}"
                                          SelectedItem="{Binding SelectedAutoReloadMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="28"
                                          Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding MonitorStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource GoldBrightBrush}"/>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="{Binding PresetListHeader}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                    </StackPanel>

                    <ListBox x:Name="PresetList"
                             ItemsSource="{Binding VisiblePresetFiles}"
                             DisplayMemberPath="DisplayName"
                             SelectedItem="{Binding SelectedPresetFile, Mode=TwoWay}"
                             SelectionChanged="PresetList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="LeftGridSplitter" Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#3A2714"
                          ShowsPreview="True"/>

            <Border Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource PaperLineBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0"
                    TextElement.Foreground="{StaticResource PaperTextBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding TableHeader}"
                               Foreground="{StaticResource PaperTextBrush}"
                               FontWeight="Bold"
                               FontSize="18"
                               Margin="0,0,0,8"/>

                    <Button x:Name="TableExpandButton"
                            DockPanel.Dock="Bottom"
                            Content="⛶"
                            Width="42"
                            Height="28"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            ToolTip="Развернуть таблицу"
                            Click="ToggleTableExpand_Click"/>

                    <DataGrid x:Name="HoursGrid"
                              AutoGenerateColumns="False"
                              AlternationCount="2"
                              CanUserAddRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              ItemsSource="{Binding Hours}"
                              SelectedItem="{Binding SelectedHour, Mode=TwoWay}"
                              IsReadOnly="False"
                              FrozenColumnCount="1">

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="IndexColumn"
                                                Header="Index"
                                                Binding="{Binding Hour}"
                                                Width="55"
                                                IsReadOnly="True"/>

                            <DataGridTemplateColumn x:Name="SunColorColumn" Header="Sun Color" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="46"
                                                Height="22"
                                                Padding="0"
                                                Margin="2"
                                                Background="{Binding SunBrush}"
                                                ToolTip="{Binding SunColorText}"
                                                Click="PickSunColorFromGrid_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="SunIntensityColumn"
                                                Header="Sun Intensity"
                                                Binding="{Binding SunIntensity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"/>

                            <DataGridTemplateColumn x:Name="AmbientColorColumn" Header="Ambient Color" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="46"
                                                Height="22"
                                                Padding="0"
                                                Margin="2"
                                                Background="{Binding AmbientBrush}"
                                                ToolTip="{Binding AmbientColorText}"
                                                Click="PickAmbientColorFromGrid_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="AmbientIntensityColumn"
                                                Header="Ambient Intensity"
                                                Binding="{Binding AmbientIntensity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="130"/>

                            <DataGridTemplateColumn x:Name="FogColorColumn" Header="Fog Color" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="46"
                                                Height="22"
                                                Padding="0"
                                                Margin="2"
                                                Background="{Binding FogBrush}"
                                                ToolTip="{Binding FogColorText}"
                                                Click="PickFogColorFromGrid_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="FogDensityColumn"
                                                Header="Fog Density"
                                                Binding="{Binding FogDensity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="100"/>

                            <DataGridTextColumn x:Name="ExposureColumn"
                                                Header="Exposure"
                                                Binding="{Binding Exposure, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90"/>

                            <DataGridTextColumn x:Name="ShadowAoColumn"
                                                Header="Shadow AO"
                                                Binding="{Binding ShadowAO, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90"/>

                            <DataGridTextColumn x:Name="EmissionColumn"
                                                Header="Emission"
                                                Binding="{Binding Emission, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90"/>

                            <DataGridTextColumn x:Name="BloomIntensityColumn"
                                                Header="Bloom Intensity"
                                                Binding="{Binding BloomIntensity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"/>

                            <DataGridTextColumn x:Name="BloomSoftColumn"
                                                Header="Bloom Soft"
                                                Binding="{Binding BloomSoftThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90"/>

                            <DataGridTextColumn x:Name="BloomThresholdColumn"
                                                Header="Bloom Threshold"
                                                Binding="{Binding BloomThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"/>

                            <DataGridTextColumn x:Name="HdrColumn"
                                                Header="HDR"
                                                Binding="{Binding HdrTexture, UpdateSourceTrigger=PropertyChanged}"
                                                Width="220"/>

                            <DataGridTemplateColumn x:Name="SeaColorColumn" Header="Sea Color" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="46"
                                                Height="22"
                                                Padding="0"
                                                Margin="2"
                                                Background="{Binding SeaBrush}"
                                                ToolTip="{Binding SeaColorText}"
                                                Click="PickSeaColorFromGrid_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="SeaParamsColumn"
                                                Header="Sea Params"
                                                Binding="{Binding SeaParamsText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="130"/>

                            <DataGridTemplateColumn x:Name="SeaSkyColumn" Header="Sea Sky Color" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="46"
                                                Height="22"
                                                Padding="0"
                                                Margin="2"
                                                Background="{Binding SeaSkyBrush}"
                                                ToolTip="{Binding SeaSkyColorText}"
                                                Click="PickSeaSkyColorFromGrid_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="RightGridSplitter" Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#3A2714"
                          ShowsPreview="True"/>

            <Border x:Name="RightPanelBorder" Grid.Column="4"
                    Background="{StaticResource DarkPanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="10"
                    TextElement.Foreground="{StaticResource GoldBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding RightPanelHeader}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,12"/>

                        <StackPanel x:Name="GrassPresetPanel" Margin="0,0,0,12">
                            <TextBlock Text="Grass Preset:"/>
                            <ComboBox ItemsSource="{Binding GrassPresetNames}"
                                      SelectedItem="{Binding SelectedGrassPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="28"
                                      Margin="0,4,0,0"/>
                        </StackPanel>

                        <GroupBox x:Name="WorldMapRootPanel" Header="World Map" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Text="Sun Azimuth:"/>
                                <TextBox Text="{Binding WorldMapSunAzimuth, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,4,0,8"/>
                                <TextBlock Text="Sun Height:"/>
                                <TextBox Text="{Binding WorldMapSunHeight, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="WeatherRootPanel" Header="Weather Preset" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Text="Location ID:"/>
                                <TextBox Text="{Binding WeatherLocationId, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,4,0,8"/>
                                <TextBlock Text="Preset Name:"/>
                                <TextBox Text="{Binding WeatherPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,4,0,8"/>
                                <TextBlock Text="Source Preset Name:"/>
                                <TextBox Text="{Binding WeatherSourcePresetName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,4,0,8"/>
                                <TextBlock Text="Weather Type:"/>
                                <TextBox Text="{Binding WeatherType, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="Выбранный индекс:"/>
                        <TextBox Text="{Binding SelectedHour.Hour, Mode=OneWay}"
                                 Height="26"
                                 Margin="0,4,0,10"
                                 IsReadOnly="True"/>

                        <GroupBox Header="Копирование параметров" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Text="Параметр:"/>
                                <ComboBox x:Name="ParameterCopyComboBox"
                                          Height="28"
                                          Margin="0,4,0,8"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Full Hour"/>
                                    <ComboBoxItem Content="Sun Full Block"/>
                                    <ComboBoxItem Content="Sun Color"/>
                                    <ComboBoxItem Content="Sun Intensity"/>
                                    <ComboBoxItem Content="Ambient Full Block"/>
                                    <ComboBoxItem Content="Ambient Color"/>
                                    <ComboBoxItem Content="Ambient Intensity"/>
                                    <ComboBoxItem Content="Fog Full Block"/>
                                    <ComboBoxItem Content="Fog Color"/>
                                    <ComboBoxItem Content="Fog Density"/>
                                    <ComboBoxItem Content="Sea Full Block"/>
                                    <ComboBoxItem Content="Sea Color"/>
                                    <ComboBoxItem Content="Sea Params"/>
                                    <ComboBoxItem Content="Sea Sky Color"/>
                                    <ComboBoxItem Content="Bloom Full Block"/>
                                    <ComboBoxItem Content="Emission"/>
                                    <ComboBoxItem Content="Exposure"/>
                                    <ComboBoxItem Content="Shadow AO"/>
                                    <ComboBoxItem Content="HDR Texture"/>
                                </ComboBox>

                                <Button Content="Копировать параметр из выбранного индекса"
                                        Height="30"
                                        Margin="0,0,0,6"
                                        Click="CopyParameter_Click"/>

                                <Button Content="Вставить в выделенные индексы"
                                        Height="30"
                                        Margin="0,0,0,6"
                                        Click="PasteParameterToSelected_Click"/>

                                <Button Content="Вставить во все индексы"
                                        Height="30"
                                        Click="PasteParameterToAll_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel x:Name="SunColorPanel">
                            <TextBlock Text="Sun Color:"/>
                            <DockPanel Margin="0,4,0,10">
                                <Button Width="44"
                                        Height="26"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="{Binding SelectedHour.SunBrush}"
                                        Click="PickSunColor_Click"/>
                                <TextBox Text="{Binding SelectedHour.SunColorText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="SunIntensityPanel">
                            <TextBlock Text="Sun Intensity:"/>
                            <TextBox Text="{Binding SelectedHour.SunIntensity, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="AmbientColorPanel">
                            <TextBlock Text="Ambient Color:"/>
                            <DockPanel Margin="0,4,0,10">
                                <Button Width="44"
                                        Height="26"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="{Binding SelectedHour.AmbientBrush}"
                                        Click="PickAmbientColor_Click"/>
                                <TextBox Text="{Binding SelectedHour.AmbientColorText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="AmbientIntensityPanel">
                            <TextBlock Text="Ambient Intensity:"/>
                            <TextBox Text="{Binding SelectedHour.AmbientIntensity, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="FogColorPanel">
                            <TextBlock Text="Fog Color:"/>
                            <DockPanel Margin="0,4,0,10">
                                <Button Width="44"
                                        Height="26"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="{Binding SelectedHour.FogBrush}"
                                        Click="PickFogColor_Click"/>
                                <TextBox Text="{Binding SelectedHour.FogColorText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="FogDensityPanel">
                            <TextBlock Text="Fog Density:"/>
                            <TextBox Text="{Binding SelectedHour.FogDensity, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="ExposurePanel">
                            <TextBlock Text="Exposure:"/>
                            <TextBox Text="{Binding SelectedHour.Exposure, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="ShadowAoPanel">
                            <TextBlock Text="Shadow AO:"/>
                            <TextBox Text="{Binding SelectedHour.ShadowAO, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="EmissionPanel">
                            <TextBlock Text="Emission:"/>
                            <TextBox Text="{Binding SelectedHour.Emission, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="BloomPanel">
                            <TextBlock Text="Bloom Intensity:"/>
                            <TextBox Text="{Binding SelectedHour.BloomIntensity, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>

                            <TextBlock Text="Bloom Soft Threshold:"/>
                            <TextBox Text="{Binding SelectedHour.BloomSoftThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>

                            <TextBlock Text="Bloom Threshold:"/>
                            <TextBox Text="{Binding SelectedHour.BloomThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="HdrPanel">
                            <TextBlock Text="HDR Texture:"/>
                            <TextBox Text="{Binding SelectedHour.HdrTexture, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="SeaColorPanel">
                            <TextBlock x:Name="SeaColorLabel" Text="Sea Color:"/>
                            <DockPanel Margin="0,4,0,10">
                                <Button Width="44"
                                        Height="26"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="{Binding SelectedHour.SeaBrush}"
                                        Click="PickSeaColor_Click"/>
                                <TextBox Text="{Binding SelectedHour.SeaColorText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="SeaParamsPanel">
                            <TextBlock Text="Sea Params:"/>
                            <TextBox Text="{Binding SelectedHour.SeaParamsText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     Margin="0,4,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="SeaSkyPanel">
                            <TextBlock x:Name="SeaSkyLabel" Text="Sea Sky Color:"/>
                            <DockPanel Margin="0,4,0,16">
                                <Button Width="44"
                                        Height="26"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="{Binding SelectedHour.SeaSkyBrush}"
                                        Click="PickSeaSkyColor_Click"/>
                                <TextBox Text="{Binding SelectedHour.SeaSkyColorText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"/>
                            </DockPanel>
                        </StackPanel>

                        <Button Content="Копировать весь индекс"
                                Height="32"
                                Margin="0,0,0,6"
                                Click="CopyHour_Click"/>

                        <Button Content="Размножить весь индекс на все"
                                Height="32"
                                Margin="0,0,0,6"
                                Click="PasteHourToAll_Click"/>

                        <Button Content="Применить изменения в JSON"
                                Height="32"
                                Click="ApplyChanges_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </DockPanel>
</Window>
